PORT=5000

# Local MongoDB (for testing) – install MongoDB Community or use Docker
MONGODB_URI=mongodb+srv://USER:Password@<CLUSTER_HOST>/<DATABASE_NAME>?retryWrites=true&w=majority

# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority

JWT_SECRET=replace_me_with_a_long_random_secret

# Comma-separated list of admin emails allowed to post referrals (empty = all users)
ADMIN_EMAILS=admin@example.com

# Boardroom AI (guest limit enforced server-side)
GEMINI_API_KEY=your_gemini_api_key
# Optional salt for hashing client IPs in boardroom abuse ledger (default is fine; set in prod for extra separation)
# BOARDROOM_IP_SALT=long_random_string

GRAMMAR_API_ENABLED=false
GRAMMAR_API_URL=https://api.languagetool.org/v2/check
GRAMMAR_LANGUAGE=en-US
GRAMMAR_TIMEOUT_MS=8000
GRAMMAR_MAX_CHARS=9000

# Browser origin(s) for CORS + Socket.IO (comma-separated). Production: list your public site(s); www and apex are expanded automatically from each entry (localhost unchanged).
# Example: CLIENT_ORIGIN=https://eliteskills.co
CLIENT_ORIGIN=http://localhost:3000
